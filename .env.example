# Copy to .env for local development. "shopify app dev" fills SHOPIFY_API_KEY, SHOPIFY_API_SECRET,
# SHOPIFY_APP_URL and SCOPES by itself; set them yourself only in production.

# PostgreSQL connection. For local work a free database from Neon, Supabase or Railway is fine.
DATABASE_URL="postgresql://user:password@host:5432/bulk_uploader?sslmode=require"

# File storage for uploaded sheets, images and reports.
# Production: Cloudflare R2 (set all four). Without R2_BUCKET, files go to STORAGE_DIR on local disk.
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
STORAGE_DIR="./storage"
# Uploaded files are deleted after this many days
FILE_RETENTION_DAYS="7"

# Job queue. Production: Redis + the worker service (npm run worker).
# Without REDIS_URL, jobs run inside the web server (fine for local development).
REDIS_URL=""
# Jobs from different stores the worker runs at the same time
WORKER_CONCURRENCY="4"

# Optional: Google service account for private Google Sheets / Drive folders.
# Paste the whole JSON key file on one line. Merchants share their files with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Production only (Shopify CLI sets these during development)
# SHOPIFY_API_KEY=""
# SHOPIFY_API_SECRET=""
# SHOPIFY_APP_URL="https://uploader.example.com"
# SCOPES="write_products,write_files"
